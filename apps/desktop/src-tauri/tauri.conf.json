{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Label Print",
  "version": "0.0.5",
  "identifier": "com.opensource.labelprint",
  "build": {
    "beforeDevCommand": "pnpm --filter @label/desktop dev -- --host 127.0.0.1 --port 5173",
    "beforeBuildCommand": "pnpm --filter @label/desktop build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Label Print",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["lpt"],
        "name": "Label Print 模板文件",
        "description": "Label Print 标签设计模板"
      }
    ]
  }
}

