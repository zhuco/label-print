{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Label Print",
  "version": "0.1.0",
  "identifier": "com.opensource.labelprint",
  "build": {
    "beforeDevCommand": "pnpm --dir ../desktop dev",
    "beforeBuildCommand": "pnpm --dir ../desktop build",
    "frontendDist": "../desktop/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Label Print",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}