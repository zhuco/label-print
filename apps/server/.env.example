# Required for a public deployment (never commit real values).
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
# Required to retrieve /metrics; use a long random value and keep it outside the desktop client.
METRICS_TOKEN=replace-with-a-separate-long-random-value
# Optional signed relay for payment-provider adapters. Do not expose this in the desktop app.
BILLING_WEBHOOK_SECRET=replace-with-a-third-long-random-value
# Optional internal release-management token. It may publish releases or set rollout to 0.
RELEASE_ADMIN_TOKEN=replace-with-a-fourth-long-random-value
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
DATABASE_URL=postgres://label:replace-me@127.0.0.1:5432/label_cloud
# Only for the single-process LOCAL_CLOUD_STORE_FILE development fallback, not production.
LOCAL_CLOUD_ASSET_DIRECTORY=./var/cloud-assets

# S3-compatible object storage. All four non-optional S3 values are required when S3_BUCKET is set.
S3_BUCKET=label-assets
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.example.com
# Optional client-reachable endpoint embedded into presigned URLs. Use this when S3_ENDPOINT is private.
S3_PUBLIC_ENDPOINT=https://cdn-or-public-s3.example.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false

# Optional SMTP for password reset. An external provider is sufficient; no self-hosted mail server is needed.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER and SMTP_PASSWORD are optional together for unauthenticated local sandboxes only.
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM="Label Cloud <no-reply@example.com>"
