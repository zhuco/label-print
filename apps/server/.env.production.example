# Copy to /opt/label-cloud/.env on the VPS with mode 600. Generate every
# *_SECRET, token and password independently; none belongs in Git or the desktop app.
POSTGRES_DB=label_cloud
POSTGRES_USER=label
POSTGRES_PASSWORD=replace-with-a-long-random-password

MINIO_ROOT_USER=label-cloud-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_API_CORS_ALLOW_ORIGIN=tauri://localhost,http://tauri.localhost,https://tauri.localhost

ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
METRICS_TOKEN=replace-with-a-long-random-token
BILLING_WEBHOOK_SECRET=replace-with-a-long-random-token
RELEASE_ADMIN_TOKEN=replace-with-a-long-random-token
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Only this fixed Docker bridge gateway may supply X-Forwarded-For.
TRUSTED_PROXY_IPS=172.30.0.1

S3_BUCKET=label-assets
S3_REGION=us-east-1
# The API uses its Docker-private endpoint. Desktop clients receive signed
# links on the same HTTPS origin as the API, avoiding a second certificate.
S3_PUBLIC_ENDPOINT=https://api1.hengceyun.com
S3_ACCESS_KEY_ID=label-cloud-admin
S3_SECRET_ACCESS_KEY=replace-with-the-same-value-as-MINIO_ROOT_PASSWORD

# Configure an external SMTP provider later if password-reset mail is needed.
SMTP_FROM="恒策标签云 <no-reply@hengceyun.com>"
